# Copy this file to android-app/keystore.properties.
# The real file is ignored by Git. Prefer an absolute path on Windows.
storeFile=C:/Users/you/.tasken/tasken-release.jks
storePassword=<set locally>
keyAlias=tasken
keyPassword=<set locally>

# Optional: configure all five values only while migrating an existing install
# from an older signing certificate. Rotation secrets are environment-only.
# TASKEN_ANDROID_LEGACY_KEYSTORE=C:/Users/you/.android/debug.keystore
# TASKEN_ANDROID_LEGACY_KEYSTORE_PASSWORD=<set locally>
# TASKEN_ANDROID_LEGACY_KEY_ALIAS=androiddebugkey
# TASKEN_ANDROID_LEGACY_KEY_PASSWORD=<set locally>
# TASKEN_ANDROID_SIGNING_LINEAGE=C:/Users/you/.tasken/tasken-signing-lineage
# TASKEN_ANDROID_ROTATION_MIN_SDK_VERSION=33
