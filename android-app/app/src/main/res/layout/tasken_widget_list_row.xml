<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/widget_row_dot"
        android:layout_width="22dp"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:padding="6dp"
        android:scaleType="centerInside"
        android:src="@drawable/tasken_widget_dot" />

    <TextView
        android:id="@+id/widget_row_title"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/tasken_widget_on_surface"
        android:textSize="13sp" />

    <ImageView
        android:id="@+id/widget_row_button"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="Taskの状態を切り替え"
        android:padding="10dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_tabler_circle"
        android:tint="@color/tasken_widget_primary" />
</LinearLayout>
