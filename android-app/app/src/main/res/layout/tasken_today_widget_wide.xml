<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/tasken_widget_background"
    android:orientation="horizontal"
    android:padding="8dp">

    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="118dp"
        android:layout_height="match_parent"
        android:background="@drawable/tasken_widget_panel_background"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:text="Today"
            android:textColor="@color/tasken_widget_on_surface"
            android:textSize="19sp" />

        <TextView
            android:id="@+id/widget_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:includeFontPadding="false"
            android:textColor="@color/tasken_widget_on_surface_variant"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="2dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:text="読込中"
            android:textColor="@color/tasken_widget_on_surface_variant"
            android:textSize="10sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_add"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:background="@drawable/tasken_widget_action_background"
                android:contentDescription="Taskを追加"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="＋"
                android:textColor="@color/tasken_widget_primary"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/widget_voice"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="2dp"
                android:layout_weight="1"
                android:background="@drawable/tasken_widget_action_background"
                android:contentDescription="音声でTaskを追加"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="🎙"
                android:textColor="@color/tasken_widget_primary"
                android:textSize="17sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_empty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="Todayは空です"
            android:textColor="@color/tasken_widget_on_surface_variant"
            android:textSize="13sp" />

        <LinearLayout android:id="@+id/widget_task_1" android:layout_width="match_parent" android:layout_height="30dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/widget_task_1_button" android:layout_width="28dp" android:layout_height="28dp" android:contentDescription="Taskの状態を切り替え" android:gravity="center" android:includeFontPadding="false" android:textColor="@color/tasken_widget_primary" android:textSize="16sp" />
            <TextView android:id="@+id/widget_task_1_title" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:ellipsize="end" android:gravity="center_vertical" android:includeFontPadding="false" android:maxLines="1" android:textColor="@color/tasken_widget_on_surface" android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/widget_task_2" android:layout_width="match_parent" android:layout_height="30dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/widget_task_2_button" android:layout_width="28dp" android:layout_height="28dp" android:contentDescription="Taskの状態を切り替え" android:gravity="center" android:includeFontPadding="false" android:textColor="@color/tasken_widget_primary" android:textSize="16sp" />
            <TextView android:id="@+id/widget_task_2_title" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:ellipsize="end" android:gravity="center_vertical" android:includeFontPadding="false" android:maxLines="1" android:textColor="@color/tasken_widget_on_surface" android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/widget_task_3" android:layout_width="match_parent" android:layout_height="30dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/widget_task_3_button" android:layout_width="28dp" android:layout_height="28dp" android:contentDescription="Taskの状態を切り替え" android:gravity="center" android:includeFontPadding="false" android:textColor="@color/tasken_widget_primary" android:textSize="16sp" />
            <TextView android:id="@+id/widget_task_3_title" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:ellipsize="end" android:gravity="center_vertical" android:includeFontPadding="false" android:maxLines="1" android:textColor="@color/tasken_widget_on_surface" android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/widget_task_4" android:layout_width="match_parent" android:layout_height="30dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/widget_task_4_button" android:layout_width="28dp" android:layout_height="28dp" android:contentDescription="Taskの状態を切り替え" android:gravity="center" android:includeFontPadding="false" android:textColor="@color/tasken_widget_primary" android:textSize="16sp" />
            <TextView android:id="@+id/widget_task_4_title" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:ellipsize="end" android:gravity="center_vertical" android:includeFontPadding="false" android:maxLines="1" android:textColor="@color/tasken_widget_on_surface" android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/widget_task_5" android:layout_width="match_parent" android:layout_height="30dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/widget_task_5_button" android:layout_width="28dp" android:layout_height="28dp" android:contentDescription="Taskの状態を切り替え" android:gravity="center" android:includeFontPadding="false" android:textColor="@color/tasken_widget_primary" android:textSize="16sp" />
            <TextView android:id="@+id/widget_task_5_title" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:ellipsize="end" android:gravity="center_vertical" android:includeFontPadding="false" android:maxLines="1" android:textColor="@color/tasken_widget_on_surface" android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/widget_task_6" android:layout_width="match_parent" android:layout_height="30dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/widget_task_6_button" android:layout_width="28dp" android:layout_height="28dp" android:contentDescription="Taskの状態を切り替え" android:gravity="center" android:includeFontPadding="false" android:textColor="@color/tasken_widget_primary" android:textSize="16sp" />
            <TextView android:id="@+id/widget_task_6_title" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:ellipsize="end" android:gravity="center_vertical" android:includeFontPadding="false" android:maxLines="1" android:textColor="@color/tasken_widget_on_surface" android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
