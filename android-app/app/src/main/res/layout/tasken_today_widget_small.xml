<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/tasken_widget_background"
    android:gravity="center"
    android:orientation="horizontal"
    android:padding="6dp">

    <TextView
        android:id="@+id/widget_add"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="3dp"
        android:layout_weight="1"
        android:background="@drawable/tasken_widget_action_background"
        android:contentDescription="Taskを追加"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="2"
        android:text="＋&#10;Task"
        android:textColor="@color/tasken_widget_primary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/widget_voice"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="3dp"
        android:layout_weight="1"
        android:background="@drawable/tasken_widget_action_background"
        android:contentDescription="音声でTaskを追加"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="2"
        android:text="🎙&#10;Voice"
        android:textColor="@color/tasken_widget_primary"
        android:textSize="13sp" />
</LinearLayout>
