<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/tasken_widget_background"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_open_today"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:text="Today"
            android:textColor="@color/tasken_widget_on_surface"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical|end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="読込中"
            android:textColor="@color/tasken_widget_on_surface_variant"
            android:textSize="11sp" />

        <ImageView
            android:id="@+id/widget_add"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/tasken_widget_action_background"
            android:contentDescription="Taskを追加"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_tabler_plus"
            android:tint="@color/tasken_widget_primary" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="今日のTaskはありません"
        android:textColor="@color/tasken_widget_on_surface_variant"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/widget_task_1"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">
        <ImageView
            android:id="@+id/widget_task_1_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="Taskの状態を切り替え"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_tabler_circle"
            android:tint="@color/tasken_widget_primary" />
        <TextView
            android:id="@+id/widget_task_1_title"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/tasken_widget_on_surface"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_task_2"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">
        <ImageView
            android:id="@+id/widget_task_2_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="Taskの状態を切り替え"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_tabler_circle"
            android:tint="@color/tasken_widget_primary" />
        <TextView
            android:id="@+id/widget_task_2_title"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/tasken_widget_on_surface"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_task_3"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">
        <ImageView
            android:id="@+id/widget_task_3_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="Taskの状態を切り替え"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_tabler_circle"
            android:tint="@color/tasken_widget_primary" />
        <TextView
            android:id="@+id/widget_task_3_title"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/tasken_widget_on_surface"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
