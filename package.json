{
  "name": "tasken",
  "version": "0.1.44",
  "description": "研究開発職向けの長期スケジュール・タスク・メモ管理デスクトップアプリ",
  "author": "ootan",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "postinstall": "patch-package && electron-builder install-app-deps",
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "node scripts/run-desktop-dev.mjs",
    "dev:wsl": "node scripts/run-desktop-dev.mjs --require-wsl",
    "dev:windows-runtime": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/run-windows-runtime.ps1",
    "doctor:desktop": "node scripts/desktop-dev-doctor.mjs",
    "doctor:mcp": "node scripts/mcp-doctor.mjs",
    "test": "node scripts/run-electron-node.mjs --test --test-concurrency=1 tests/*.test.mjs",
    "test:full": "node scripts/run-electron-node.mjs --test --test-concurrency=1 tests/*.test.mjs",
    "test:unit-contract": "node scripts/run-electron-node.mjs --test tests/architecture-audit.test.mjs tests/audit-tools.test.mjs tests/bundled-fonts.test.mjs tests/desktop-dev-doctor.test.mjs tests/entity-registry-theme.test.mjs tests/electron-smoke-runner.test.mjs tests/personal-default-theme.test.mjs tests/theme-picker-ui.test.mjs tests/semantic-registry.test.mjs tests/semantic-actions.test.mjs tests/storage-resolver.test.mjs tests/task-capability.test.mjs tests/task-contract.test.mjs tests/task-main-module.test.mjs",
    "test:behavior": "node scripts/run-electron-node.mjs --test tests/application-command.test.mjs tests/note-draft-identity.test.mjs tests/canonical-markdown.test.mjs tests/canonical-markdown-workspace.test.mjs tests/note-draft-flush-registry.test.mjs tests/note-draft-save-queue.test.mjs tests/document-publish.test.mjs tests/satellite-window-state.test.mjs tests/workspace-domain.test.mjs",
    "typecheck": "tsc -b",
    "build": "electron-vite build",
    "build:mcp": "node scripts/build-mcp-bridge.mjs",
    "hooks:codex:install": "npm run build:mcp && node scripts/manage-agent-session-hooks.mjs install --client codex",
    "hooks:codex:status": "node scripts/manage-agent-session-hooks.mjs status --client codex",
    "hooks:codex:uninstall": "node scripts/manage-agent-session-hooks.mjs uninstall --client codex",
    "hooks:copilot:install": "npm run build:mcp && node scripts/manage-agent-session-hooks.mjs install --client github_copilot",
    "hooks:copilot:status": "node scripts/manage-agent-session-hooks.mjs status --client github_copilot",
    "hooks:copilot:uninstall": "node scripts/manage-agent-session-hooks.mjs uninstall --client github_copilot",
    "desktop": "npm run build && electron --disable-gpu --disable-gpu-compositing .",
    "smoke:desktop": "npm run build && node scripts/run-electron-smoke.mjs",
    "smoke:desktop:focused": "node scripts/run-electron-smoke.mjs",
    "smoke:desktop:packaged": "node scripts/run-packaged-electron-smoke.mjs",
    "smoke:activity:packaged": "node scripts/activity-electron-smoke.mjs release/win-unpacked/Tasken.exe",
    "smoke:proposal-live": "npm run build && npm run build:mcp && node scripts/live-proposal-electron-smoke.mjs",
    "smoke:proposal-live:focused": "node scripts/live-proposal-electron-smoke.mjs",
    "smoke:proposal-live:packaged": "node scripts/live-proposal-electron-smoke.mjs release/win-unpacked/Tasken.exe",
    "smoke:mcp-package": "node scripts/mcp-package-smoke.mjs",
    "audit:responsive": "node scripts/responsive-audit.mjs",
    "audit:materials-demo": "node scripts/audit-materials-demo.mjs",
    "audit:note-window": "node scripts/note-window-audit.mjs",
    "audit:mermaid-powerpoint": "node scripts/mermaid-powerpoint-audit.mjs",
    "bench:notes": "npm run build && node scripts/notes-performance.mjs",
    "workspace:materials-demo": "node scripts/run-electron-node.mjs scripts/seed-materials-informatics-workspace.mjs --apply-local",
    "workspace:materials-demo:today": "node scripts/run-electron-node.mjs scripts/update-materials-informatics-workspace.mjs --apply-local --mode refresh",
    "workspace:materials-demo:add": "node scripts/run-electron-node.mjs scripts/update-materials-informatics-workspace.mjs --apply-local --mode add",
    "workspace:agent-session-entry-demo": "node scripts/seed-agent-session-entry-demo.mjs",
    "smoke:model": "electron --no-sandbox scripts/model-smoke.mjs",
    "mcp": "node scripts/mcp-server.mjs",
    "rebuild:electron": "electron-rebuild --force -w better-sqlite3",
    "audit:consistency": "node scripts/audit-consistency.mjs",
    "audit:architecture": "node scripts/audit-architecture.mjs",
    "audit:scripts": "node scripts/audit-scripts.mjs",
    "ci": "node scripts/run-ci.mjs",
    "package": "node scripts/assert-windows-build-host.mjs && npm run typecheck && npm run build && npm run build:mcp && npm run rebuild:electron && electron-builder --publish never --win nsis portable --config.electronDist=node_modules/electron/dist",
    "release:verify-version": "node scripts/verify-release-version.mjs",
    "release:verify-artifacts": "node scripts/verify-release-artifacts.mjs",
    "release:checksum": "node scripts/write-release-checksums.mjs",
    "release:check": "node scripts/assert-windows-build-host.mjs && npm run release:verify-version && npm run ci && npm run package && npm run release:verify-artifacts && npm run smoke:desktop:packaged && npm run smoke:activity:packaged && npm run smoke:proposal-live:packaged && npm run smoke:mcp-package"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^25.9.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "^37.10.3",
    "electron-builder": "^26.15.5",
    "electron-vite": "^5.0.0",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "patch-package": "^8.0.1",
    "playwright": "^1.61.0",
    "prettier": "^3.9.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "6.4.3"
  },
  "build": {
    "appId": "jp.personal.tasken",
    "productName": "Tasken",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "mcp-dist",
        "to": "mcp"
      },
      {
        "from": "node_modules/@fontsource-variable/nunito/LICENSE",
        "to": "licenses/Nunito-OFL-1.1.txt"
      },
      {
        "from": "node_modules/@fontsource-variable/noto-sans-jp/LICENSE",
        "to": "licenses/Noto-Sans-JP-OFL-1.1.txt"
      },
      {
        "from": "node_modules/@fontsource-variable/jetbrains-mono/LICENSE",
        "to": "licenses/JetBrains-Mono-OFL-1.1.txt"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/ffmpeg-static/ffmpeg.exe"
    ],
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Tasken-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Tasken-Portable-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@codemirror/view": "^6.43.4",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/noto-sans-jp": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@mdxeditor/editor": "^4.0.4",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tabler/icons-react": "^3.44.0",
    "adm-zip": "^0.5.17",
    "better-sqlite3": "^12.11.1",
    "ffmpeg-static": "^5.2.0",
    "katex": "^0.17.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm-strikethrough": "^2.0.0",
    "mdast-util-gfm-table": "^2.0.0",
    "mdast-util-math": "^3.0.0",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^11.16.0",
    "micromark-extension-cjk-friendly": "^2.0.1",
    "micromark-extension-cjk-friendly-gfm-strikethrough": "^2.0.1",
    "micromark-extension-gfm-table": "^2.1.1",
    "micromark-extension-math": "^3.1.0",
    "pptxgenjs": "4.0.1",
    "zod": "^4.0.0",
    "zustand": "^5.0.14"
  }
}
