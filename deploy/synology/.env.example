# コンテナを実行するUID/GID。NASの共有フォルダと state の所有者に合わせる。
# 例: ssh で `id -u <dsm-user>` / `id -g <dsm-user>` を確認して設定する。
TASKEN_UID=1000
TASKEN_GID=1000

# Synology共有フォルダ(synoacl)のadministratorsグループgid。DSM標準は101。
# 共有フォルダのACLが別グループを許可している場合だけ合わせる。
TASKEN_ADMIN_GID=101

# NAS上の同期フォルダ（データ端末と同じ共有フォルダ）の絶対パス。
# 例: \\synologyDS723\Tasken\sync に対応する /volume1/Tasken/sync
TASKEN_SYNC_DIR=/volume1/Tasken/sync

# Coreが受け付ける書き込みの範囲。既定はread-only。
# proposalsにすると、テキストのFeed投稿・Note案・Task案・Task作業報告だけをProposalとして受け付ける
# （正式データはDesktopでの採用まで変わらない。直接開始start_task_workは公開しない）。
# proposalsを実際に使うには、tunnel側のTASKEN_MCP_READ_ONLYも0にする（両方必要）。
TASKEN_CORE_WRITE_MODE=read-only

# tunnel側でwrite toolsを公開するか。既定は1（読み取りのみ）。
# proposals配備では0にする。nas-install.shの再実行でもこの値は保持される。
TASKEN_MCP_READ_ONLY=1

# Phase 3: OpenAI Secure MCP Tunnelのtunnel-id。未使用なら空のまま。
# 例: tunnel_0123456789abcdef0123456789abcdef
# Runtime API keyは secrets/control_plane_api_key に置く（.envへは書かない）。
CONTROL_PLANE_TUNNEL_ID=
